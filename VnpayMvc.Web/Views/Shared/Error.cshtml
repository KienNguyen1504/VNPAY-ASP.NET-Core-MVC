@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="panel mx-auto" style="max-width: 560px">
    <h1 class="h2">Không xử lý được yêu cầu</h1>
    <p class="text-muted">Máy chủ gặp lỗi khi xử lý trang này. Quay lại trang chủ và thử lại; nếu lỗi lặp lại, gửi mã yêu cầu bên dưới cho nhóm phát triển.</p>

    @if (Model.ShowRequestId)
    {
        <p class="ds-note">Mã yêu cầu: <span class="ds-code">@Model.RequestId</span></p>
    }

    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>
